# Casbah storefront — client environment
#
# Copy to `.env` for local work. `.env` is gitignored; this file is not, so it
# is the only place the production URL is written down outside the Vercel
# dashboard. Keep it in step when the API moves.
#
# NEVER put a secret in here. Everything prefixed VITE_ is inlined into the
# JavaScript bundle and is readable by anyone who opens the site.

# Where the API lives. `/api` is appended automatically if absent, so both
# `http://localhost:4000` and `http://localhost:4000/api` work.
#
#   local          http://localhost:4000       <- the API you run yourself
#   production     https://casbah-production.up.railway.app
#
# In production this is NOT read from this file: it is set as an environment
# variable on the Vercel project (Settings -> Environment Variables), because
# Vite bakes the value in at build time. Changing it there requires a redeploy
# to take effect.
VITE_API_URL=http://localhost:4000
