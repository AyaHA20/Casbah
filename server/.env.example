# Casbah API — server environment
#
# Copy to `.env` for local work. `.env` is gitignored; this file is not, so it
# must contain PLACEHOLDERS ONLY — never a real key.
#
# In production these are set on the Railway service (Variables tab), not from
# a file. Keep the key list here in step so nothing is discoverable only from a
# dashboard.

# Neon Postgres. Pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Seeded admin account. Set this before the seed runs anywhere real — the seed
# falls back to a published development default and warns if it is missing.
ADMIN_PASSWORD=change-me

# Signs admin JWTs. Rotate for production; rotating logs every admin out.
# Never prefix with VITE_ — that would ship it in the browser bundle.
JWT_SECRET=change-me-to-a-long-random-string

# 4000 locally. Railway injects its own PORT, so leave it unset there.
PORT=4000

# Origin allowed to call this API.
#   local        http://localhost:5173
#   production   the Vercel deployment URL
CORS_ORIGIN=http://localhost:5173

# Supabase Storage, for product photos.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# SERVER-SIDE ONLY. This key bypasses row-level security. It must never be
# prefixed with VITE_ and must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
